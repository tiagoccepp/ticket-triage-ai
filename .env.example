# Ticket Triage AI — local config (copy to .env)
# SQLite is the default (offline-friendly). For Postgres:
# DATABASE_URL=postgresql://user:password@localhost:5432/triage
DATABASE_URL=sqlite:///./data/triage.db

# LLM backend: "mock" (default, offline) | "openai_compatible" (needs key + base url)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Confidence-gated automation thresholds
AUTO_THRESHOLD=0.80
REVIEW_THRESHOLD=0.55
DUPLICATE_THRESHOLD=0.82

ENVIRONMENT=development
